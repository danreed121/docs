{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "cbapp-core",
  "colors": {
    "primary": "#0066FF",
    "light": "#7AAFFF",
    "dark": "#0047B3"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "index",
          "developer-guide"
        ]
      },
      {
        "group": "Controllers",
        "pages": [
          "controllers/index",
          "controllers/view-controller",
          "controllers/rest-controller",
          "controllers/api-controller",
          "controllers/drawer-controller",
          "controllers/upload-controller"
        ]
      },
      {
        "group": "REST API",
        "pages": [
          "api/index",
          {
            "group": "Operations",
            "pages": [
              "api/operations/load",
              "api/operations/set-properties",
              "api/operations/delete",
              "api/operations/restore",
              "api/operations/pass"
            ]
          },
          {
            "group": "Parameters",
            "pages": [
              "api/parameters/path",
              "api/parameters/query",
              "api/parameters/form",
              "api/parameters/property",
              "api/parameters/custom-property",
              "api/parameters/file-input",
              "api/parameters/restriction-flags",
              "api/parameters/transform"
            ]
          }
        ]
      },
      {
        "group": "UI Utilities",
        "pages": [
          "ui/index",
          "ui/toast",
          "ui/impact-check"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/Wrycan/cbapp-core"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Wrycan"
    }
  }
}
